    "type": "git",
    "url": "git+https://github.com/adeerkhan/vitruvius.git"
  },
  "exports": {
    ".": "./.opencode/plugins/vitruvius.mjs",
    "./server": "./.opencode/plugins/vitruvius.mjs",
